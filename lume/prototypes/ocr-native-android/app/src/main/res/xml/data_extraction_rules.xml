<?xml version="1.0" encoding="utf-8"?>
<!-- Endereço e chave do servidor dos modelos ficam só neste aparelho (nem backup nem transferência). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lume_servidor.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lume_servidor.xml"/>
    </device-transfer>
</data-extraction-rules>
